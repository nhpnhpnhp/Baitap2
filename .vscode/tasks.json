{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build WAR",
            "type": "shell",
            "command": "mvn.cmd",
            "args": [
                "clean",
                "package"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Start Tomcat",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/start.ps1"
            ]
        }
    ]
}
